---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  title: string;
  lede: string;
}
const { image, alt = '', title, lede } = Astro.props;
---
<section class="hero">
  <div class="wrap grid">
    <div class="copy">
      <h1>{title}</h1>
      <p class="lede muted">{lede}</p>
    </div>

    <div class="frame figure-reveal">
      {image ? (
        <Image src={image} alt={alt} class="photo" width={1200} height={1500} loading="eager" />
      ) : (
        <div class="frame-fill" role="img" aria-label={alt || 'Pending photography'}>
          <span class="pending">Photography pending — {alt || 'hero asset'}</span>
        </div>
      )}
      <span class="scroll-mark">Scroll</span>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: 90px;
    padding-bottom: 60px;
  }
  .grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(24px, 6vw, 90px);
    align-items: center;
    width: 100%;
  }
  .copy h1 {
    color: var(--paper);
    max-width: 12ch;
  }
  .copy .lede {
    margin-top: 26px;
    max-width: 32ch;
  }
  .frame {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: 66svh;
    overflow: hidden;
  }
  .photo, .frame-fill {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 35%;
  }
  .frame-fill {
    background: #121210;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pending {
    font-family: var(--font-sans);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(242, 239, 230, 0.28);
    border: 1px dashed rgba(242, 239, 230, 0.18);
    padding: 10px 14px;
    text-align: center;
    max-width: 70%;
  }
  .scroll-mark {
    position: absolute;
    right: 16px;
    bottom: 14px;
    font-family: var(--font-sans);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(242, 239, 230, 0.5);
  }

  @media (max-width: 860px) {
    .hero { padding-top: 120px; align-items: flex-start; }
    .grid { grid-template-columns: 1fr; gap: 40px; }
    .frame { aspect-ratio: 5 / 4; max-height: none; order: -1; }
    .copy h1 { max-width: none; }
  }
</style>
