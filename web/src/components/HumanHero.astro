---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import FieldNote from './FieldNote.astro';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  eyebrow: string;
  title: string;
  lede: string;
  note?: string;
}
const { image, alt = '', eyebrow, title, lede, note } = Astro.props;
---
<section class="hero">
  <div class="frame figure-reveal">
    {image ? (
      <Image src={image} alt={alt} class="photo" width={1800} height={2200} loading="eager" />
    ) : (
      <div class="frame-fill" role="img" aria-label={alt || 'Pending photography'}>
        <span class="pending">Photography pending — {alt || 'hero asset'}</span>
      </div>
    )}
    <div class="scrim"></div>
  </div>

  <div class="wrap copy">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lede muted">{lede}</p>
  </div>

  {note && <FieldNote text={note} position="bottom-right" />}
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .frame {
    position: absolute;
    inset: 0;
  }
  .photo,
  .frame-fill {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 30%;
  }
  .frame-fill {
    background: #16150f;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pending {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(242, 239, 230, 0.28);
    border: 1px dashed rgba(242, 239, 230, 0.18);
    padding: 10px 16px;
  }
  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(9, 9, 7, 0.86) 0%, rgba(9, 9, 7, 0.28) 42%, rgba(9, 9, 7, 0.04) 68%);
  }
  .copy {
    position: relative;
    z-index: 5;
    padding-bottom: clamp(56px, 10vh, 108px);
    padding-top: clamp(120px, 30vh, 260px);
  }
  .copy .eyebrow { color: var(--paper-dim); margin-bottom: 18px; }
  .copy h1 { max-width: 15ch; color: var(--paper); }
  .copy .lede { margin-top: 20px; max-width: 40ch; }

  @media (max-width: 640px) {
    .hero { min-height: 92svh; }
    .photo, .frame-fill { object-position: 68% 24%; }
    .copy { padding-top: 140px; padding-bottom: 44px; }
  }
</style>
