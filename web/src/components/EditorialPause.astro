---
interface Props {
  label: string;
  steps: string[];
}
const { label, steps } = Astro.props;
const lift = [0, -16, -4, -22, 10, -12];
---
<section class="system reveal">
  <div class="wrap">
    <p class="eyebrow head">{label}</p>

    <div class="row">
      {steps.map((step, i) => (
        <>
          <span class="step" style={`transform: translateY(${lift[i % lift.length]}px)`}>{step}</span>
          {i < steps.length - 1 && <span class="arrow" aria-hidden="true">→</span>}
        </>
      ))}
    </div>

    <svg class="curve" viewBox="0 0 1200 90" preserveAspectRatio="none" aria-hidden="true">
      <path
        d="M10 66 C 140 8, 230 88, 360 40 S 620 4, 760 56 S 1040 10, 1190 46"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
      />
      <circle cx="10" cy="66" r="4.5" fill="currentColor" />
      <circle cx="1190" cy="46" r="4.5" fill="currentColor" />
    </svg>
  </div>
</section>

<style>
  .system {
    background: var(--cream);
    color: var(--cream-ink);
    padding: clamp(90px, 16vh, 170px) 0 clamp(70px, 12vh, 130px);
  }
  .head { color: var(--cream-ink); opacity: 0.55; margin-bottom: clamp(48px, 9vh, 96px); }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    row-gap: 14px;
    column-gap: 14px;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(15px, 1.9vw, 21px);
  }
  .step { white-space: nowrap; display: inline-block; }
  .arrow { color: rgba(21, 20, 15, 0.35); font-style: normal; }
  .curve {
    display: block;
    width: 100%;
    height: clamp(50px, 8vh, 90px);
    margin-top: clamp(20px, 4vh, 44px);
    color: rgba(21, 20, 15, 0.3);
  }

  @media (max-width: 640px) {
    .row { font-size: 15px; row-gap: 10px; }
    .step { transform: none !important; }
    .curve { height: 46px; margin-top: 28px; }
  }
</style>
