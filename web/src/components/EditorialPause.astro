---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  statement: string;
}
const { image, alt = '', statement } = Astro.props;
---
<section class="pause">
  <div class="frame figure-reveal parallax-slow">
    {image ? (
      <Image src={image} alt={alt} class="photo" width={2200} height={1500} loading="lazy" />
    ) : (
      <div class="frame-fill" role="img" aria-label={alt || 'Pending photography'}>
        <span class="pending">Photography pending — {alt || 'scene asset'}</span>
      </div>
    )}
  </div>

  <div class="wrap statement-row reveal">
    <p class="serif statement">{statement}</p>
  </div>
</section>

<style>
  .pause {
    padding-top: clamp(90px, 14vh, 160px);
  }
  .frame {
    height: 78vh;
    min-height: 420px;
    overflow: hidden;
  }
  .photo, .frame-fill {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 38%;
  }
  .frame-fill {
    background: #14140f;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pending {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(242, 239, 230, 0.28);
    border: 1px dashed rgba(242, 239, 230, 0.18);
    padding: 10px 16px;
  }
  .statement-row {
    padding-top: clamp(60px, 12vh, 120px);
    padding-bottom: clamp(90px, 16vh, 160px);
  }
  .statement {
    max-width: 16ch;
    font-size: clamp(24px, 3.6vw, 38px);
    color: var(--paper);
  }
</style>
