---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  eyebrow: string;
  title: string;
  body: string;
  href: string;
  linkLabel?: string;
}
const { image, alt = '', eyebrow, title, body, href, linkLabel = 'Read the case' } = Astro.props;
---
<section class="case">
  <hr class="rule wrap" />
  <div class="wrap grid">
    <div class="frame figure-reveal">
      {image ? (
        <Image src={image} alt={alt} class="photo" width={1600} height={2000} loading="lazy" />
      ) : (
        <div class="frame-fill" role="img" aria-label={alt || 'Pending photography'}>
          <span class="pending">Photography pending — {alt || 'case asset'}</span>
        </div>
      )}
    </div>
    <div class="detail reveal">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
      <p class="body muted">{body}</p>
      <a class="link-line" href={href}>{linkLabel} →</a>
    </div>
  </div>
</section>

<style>
  .case { padding-top: clamp(90px, 14vh, 150px); padding-bottom: clamp(90px, 14vh, 150px); }
  .grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(28px, 6vw, 80px);
    align-items: center;
    margin-top: clamp(50px, 8vh, 90px);
  }
  .frame { aspect-ratio: 4 / 5; overflow: hidden; }
  .photo, .frame-fill {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .frame-fill {
    background: #131310;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pending {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(242, 239, 230, 0.28);
    border: 1px dashed rgba(242, 239, 230, 0.18);
    padding: 10px 16px;
    text-align: center;
  }
  .detail .eyebrow { color: var(--paper-dim); margin-bottom: 20px; }
  .detail h2 { max-width: 12ch; }
  .detail .body { margin-top: 22px; max-width: 34ch; font-size: 15px; }
  .detail .link-line { margin-top: 26px; }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
    .frame { aspect-ratio: 5 / 4; }
  }
</style>
