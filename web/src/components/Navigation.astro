---
const links = [
  { href: '/stance-signal-site/real-estate/', label: 'Real Estate' },
  { href: '/stance-signal-site/cases/', label: 'Cases' },
  { href: '/stance-signal-site/method/', label: 'Method' },
  { href: '/stance-signal-site/start/', label: 'Start' },
];
---
<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/stance-signal-site/">Stance &amp; Signal</a>
    <nav class="links" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .nav {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    padding: 26px 0;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .brand {
    font-family: var(--font-serif);
    font-size: 15px;
    letter-spacing: -0.01em;
    color: var(--paper);
  }
  .links {
    display: flex;
    gap: 28px;
    font-size: 12px;
    letter-spacing: 0.04em;
  }
  .links a {
    color: var(--paper-dim);
    padding-bottom: 3px;
    border-bottom: 1px solid transparent;
  }
  .links a:hover {
    color: var(--paper);
    border-color: var(--paper-dim);
  }
  @media (max-width: 640px) {
    .links { gap: 16px; font-size: 11px; }
  }
</style>
