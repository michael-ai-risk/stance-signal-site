---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Start — Stance & Signal"
  description="Bring one real business question to Stance & Signal."
>
  <section class="stub wrap">
    <p class="eyebrow muted">A first step</p>
    <h1>Test the judgment.</h1>
    <p class="lede muted">Bring one real business question. You do not need a perfect brief. This section is being built.</p>
  </section>
</BaseLayout>

<style>
  .stub { padding-top: clamp(150px, 26vh, 220px); padding-bottom: clamp(120px, 20vh, 180px); }
  .stub .eyebrow { margin-bottom: 22px; }
  .stub .lede { margin-top: 22px; max-width: 48ch; }
</style>
