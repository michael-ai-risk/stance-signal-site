---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Method — Stance & Signal"
  description="Evidence and method boundaries for Stance & Signal."
>
  <section class="stub wrap">
    <p class="eyebrow muted">Method and boundary</p>
    <h1>Evidence before certainty.</h1>
    <p class="lede muted">Clear boundaries build trust. This section is being built.</p>
  </section>
</BaseLayout>

<style>
  .stub { padding-top: clamp(150px, 26vh, 220px); padding-bottom: clamp(120px, 20vh, 180px); }
  .stub .eyebrow { margin-bottom: 22px; }
  .stub .lede { margin-top: 22px; max-width: 48ch; }
</style>
