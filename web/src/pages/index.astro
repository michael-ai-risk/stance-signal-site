---
import BaseLayout from '../layouts/BaseLayout.astro';
import HumanHero from '../components/HumanHero.astro';
import EditorialPause from '../components/EditorialPause.astro';
---
<BaseLayout
  title="Stance & Signal — Judgment for decisions in motion"
  description="An independent judgment practice for decisions that keep changing. Real estate is where we operate first."
>
  <HumanHero
    title="Judgment for decisions in motion."
    lede="We examine. We challenge. We take a position."
    alt="A figure crosses a shaft of light in an otherwise dark space"
  />

  <EditorialPause
    label="The system (not software)"
    steps={["evidence & case", "diagnosis", "specialist capabilities", "research + models", "challenge", "human judgment"]}
  />
</BaseLayout>
